{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Card Studio",
  "version": "1.0.0",
  "identifier": "app.cardstudio.offline",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Card Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#222637"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Offline custom card creator",
    "longDescription": "Create custom trading cards offline: frames, text, art, set symbols, watermarks, gallery and printable PDF sheets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "graphics" },
      "rpm": { "release": "1" }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
